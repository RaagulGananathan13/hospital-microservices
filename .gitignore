# Dependencies
node_modules/
**/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Environment files (keep local secrets out of git)
.env
.env.*
!.env.example

# Build outputs
build/
dist/
coverage/
.nyc_output/

# Caches
.cache/
.tmp/
.temp/

# OS files
.DS_Store
Thumbs.db

# IDE/editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Python artifacts (for helper scripts)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
